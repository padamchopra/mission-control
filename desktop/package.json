{
  "name": "remy-desktop",
  "productName": "Remy",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "me.padamchopra.Remy",
    "productName": "Remy",
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "../web/src/assets/remy-mark.png",
      "target": [
        "dmg"
      ],
      "artifactName": "Remy-${version}-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "title": "Remy ${version}"
    }
  }
}
